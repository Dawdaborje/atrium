{
  "model": "news_post",
  "access": [
    {
      "name": "self",
      "roles": [
        "via:self"
      ],
      "operations": [
        "read",
        "create",
        "write",
        "delete"
      ]
    },
    {
      "name": "published_read",
      "operations": [
        "read"
      ],
      "when": {
        "status": "published"
      }
    }
  ]
}