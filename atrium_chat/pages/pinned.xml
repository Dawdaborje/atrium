<page route="/chat/{channel}/pinned" title="Pinned messages" menu="false">
  <view type="list" source="pinned_messages" open="/chat/{channel}">
    <columns>
      <column field="author_name" label="From"/>
      <column field="body" label="Message"/>
      <column field="at" label="When" fieldType="datetime"/>
    </columns>
    <actions>
      <action name="unpin" label="Unpin" function="pin_message"/>
    </actions>
  </view>
</page>
