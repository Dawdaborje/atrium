<page route="/calendar/new" title="New event" menu="false">
  <view type="form" function="create_event" submit="Add event" success="Event added" redirect="/calendar/event/{id}">
    <group title="Event" cols="2">
      <field name="title" label="Title" colspan="2" required="true"/>
      <field name="starts_at" label="Starts" fieldType="datetime" required="true"/>
      <field name="ends_at" label="Ends" fieldType="datetime"/>
      <field name="all_day" label="All day" fieldType="boolean"/>
      <field name="calendar" label="Calendar" fieldType="many2one" source="pick_calendars" optionLabel="name" entity="calendars" help="Your own calendar when left empty."/>
      <field name="repeat" label="Repeats" fieldType="selection" options="none, daily, weekly, monthly, yearly"/>
      <field name="until" label="Repeats until" fieldType="date"/>
      <field name="location" label="Where"/>
      <field name="attendees" label="Invite" fieldType="many2many" source="pick_org_people" optionLabel="name" entity="people" colspan="2"/>
      <field name="description" label="Notes" fieldType="text" colspan="2"/>
    </group>
  </view>
</page>
