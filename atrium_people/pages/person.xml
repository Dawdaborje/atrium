<page route="/people/{id}" title="Profile" menu="false">
  <view type="form" source="person">
    <header>
      <button label="Edit this profile" href="/people/{id}/edit"/>
      <button label="Org chart" href="/people/chart/{id}"/>
    </header>
    <group title="Profile" cols="2">
      <field name="name" label="Name" readonly="true"/>
      <field name="title" label="Job title" readonly="true"/>
      <field name="department" label="Department" readonly="true"/>
      <field name="manager_name" label="Reports to" readonly="true"/>
      <field name="email" label="Email" readonly="true"/>
      <field name="phone" label="Phone" readonly="true"/>
      <field name="mobile" label="Mobile" readonly="true"/>
      <field name="location" label="Location" readonly="true"/>
      <field name="away_text" label="Status" readonly="true"/>
      <field name="birthday" label="Birthday" readonly="true"/>
      <field name="started" label="Started" readonly="true"/>
      <field name="skills" label="Skills" readonly="true" colspan="2"/>
      <field name="bio" label="About" fieldType="text" readonly="true" colspan="2"/>
    </group>
  </view>
  <view type="list" source="person_reports" open="/people/{id}">
    <columns>
      <column field="name" label="Direct reports"/>
      <column field="title" label="Job title"/>
    </columns>
    <empty title="No direct reports"/>
  </view>
  <view type="list" source="person_chain" open="/people/{id}">
    <columns>
      <column field="name" label="Reports up through"/>
      <column field="title" label="Job title"/>
    </columns>
    <empty title="Nobody above"/>
  </view>
</page>
