{
  "model": "mail_thread",
  "access": [
    {
      "name": "self",
      "roles": [
        "via:self"
      ],
      "operations": [
        "read",
        "create",
        "write",
        "delete"
      ]
    },
    {
      "name": "members_read",
      "operations": [
        "read"
      ],
      "when": {
        "box": "$my_boxes"
      }
    }
  ]
}